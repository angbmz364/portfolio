---
import Layout from "../layouts/Layout.astro";
import AgencyNav from "../components/agency/AgencyNav.astro";
import Footer from "../sections/Footer.astro";
import { projects } from "../data/projects.js";

const PHONE = "51976392715";
const EMAIL = "angel@diofstudios.com";
const wa = (text: string) => `https://wa.me/${PHONE}?text=${encodeURIComponent(text)}`;

const commitments = [
    ["Cotización gratis", "Te respondemos en menos de 24 horas, sin compromiso."],
    ["Todo es tuyo", "El dominio, el código y las cuentas quedan a tu nombre."],
    ["Por escrito", "Alcance, precio y plazo acordados antes de empezar."],
];

const services = [
    {
        name: "Páginas web",
        text: "Sitio rápido, claro y pensado para que te escriban por WhatsApp. Se ve bien en el celular, que es donde te buscan.",
        cta: "Quiero mi web",
        msg: "Hola SaskDev, quiero una página web para mi negocio.",
    },
    {
        name: "Tiendas online",
        text: "Catálogo, carrito y cobros con Yape, Plin o tarjeta. Tú administras tus productos sin depender de nadie.",
        cta: "Quiero vender online",
        msg: "Hola SaskDev, quiero una tienda online para mi negocio.",
    },
    {
        name: "Software y apps a medida",
        text: "Sistemas de reservas, inventario, ventas o gestión interna, y apps móviles, hechos para cómo trabaja tu empresa.",
        cta: "Quiero mi software",
        msg: "Hola SaskDev, necesito un software o app a medida.",
    },
    {
        name: "IA y automatización",
        text: "Asistentes, respuestas automáticas y procesos que ahorran horas a tu equipo. Experiencia real con modelos que corren incluso sin internet.",
        cta: "Quiero automatizar",
        msg: "Hola SaskDev, quiero automatizar procesos con IA en mi negocio.",
    },
    {
        name: "Mantenimiento y soporte",
        text: "Cambios, actualizaciones, seguridad y respaldos para que tu web o sistema siga funcionando mes a mes.",
        cta: "Quiero soporte",
        msg: "Hola SaskDev, necesito mantenimiento para mi web o sistema.",
    },
];

const demos = [
    {
        name: "Chullos Travel Perú",
        text: "Rediseño de agencia de turismo en Cusco: tours claros y cada botón lleva directo a WhatsApp.",
        img: "/agency/chullos-travel-peru.webp",
    },
    {
        name: "Tours Cusco Machu Picchu",
        text: "De un enlace en Beacons a una web propia con rutas, cómo operan y cotización inmediata.",
        img: "/agency/tours-cusco-machu-picchu.webp",
    },
    {
        name: "Viajes Cusco Perú",
        text: "Rediseño con precios publicados, horarios y contacto visibles desde la primera pantalla.",
        img: "/agency/viajes-cusco-peru.webp",
    },
];

---

<Layout
    title="SaskDev Agency | Páginas web, software e IA para negocios en Perú"
    description="Agencia de desarrollo web y software en Perú. Páginas web, tiendas online, apps a medida e IA. Cotización gratis en menos de 24 horas."
>
    <AgencyNav wa={wa("Hola SaskDev, quiero cotizar un proyecto.")} />

    <main class="flex-1 min-w-0 max-w-4xl flex items-start justify-start md:self-start flex-col px-0 md:px-12 py-10">
        <section id="home" class="py-24 md:py-32 space-y-8 w-full">
            <h1 class="text-4xl md:text-6xl font-semibold leading-[1.05] tracking-tight text-balance">
                Tu negocio, vendiendo en internet las 24 horas.
            </h1>
            <p class="text-lg max-w-xl">
                Creamos páginas web, tiendas online, software e inteligencia artificial para negocios del Perú.
                Tú nos cuentas qué necesitas, nosotros lo construimos y lo ponemos en línea.
            </p>
            <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
                <a class="cta-primary" href={wa("Hola SaskDev, quiero cotizar un proyecto.")} target="_blank" rel="noopener">
                    Cotizar por WhatsApp
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                </a>
                <a href="#servicios" class="underline text-neutral-300 hover:text-white">Ver servicios</a>
            </div>

            <ul class="grid md:grid-cols-3 border-t border-neutral-900 mt-16">
                {commitments.map(([title, text]) => (
                    <li class="py-6 md:pr-6 border-b md:border-b-0 md:border-r border-neutral-900 last:border-0 md:pl-6 first:md:pl-0 space-y-1">
                        <p class="font-semibold text-neutral-100!">{title}</p>
                        <p class="text-sm">{text}</p>
                    </li>
                ))}
            </ul>
        </section>

        <section id="servicios" class="py-24 space-y-8 border-t border-neutral-900 w-full scroll-mt-4">
            <h2 class="section-title"><span class="text-sm text-neutral-600">01</span>Servicios</h2>
            <ol>
                {services.map((s) => (
                    <li class="grid gap-4 py-8 border-t border-neutral-900 md:grid-cols-[1fr_auto] md:items-center md:gap-10">
                        <div class="space-y-2">
                            <h3 class="text-xl font-semibold text-neutral-100">{s.name}</h3>
                            <p class="max-w-xl">{s.text}</p>
                        </div>
                        <a class="cta-link" href={wa(s.msg)} target="_blank" rel="noopener">
                            {s.cta}
                            <svg class="size-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                        </a>
                    </li>
                ))}
            </ol>
        </section>

        <section id="trabajos" class="py-24 space-y-8 border-t border-neutral-900 w-full scroll-mt-4">
            <div class="flex items-end justify-between gap-6">
                <h2 class="section-title"><span class="text-sm text-neutral-600">02</span>Trabajos</h2>
                <div class="flex gap-2">
                    <button type="button" class="car-btn" data-dir="-1" aria-label="Anterior">
                        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
                    </button>
                    <button type="button" class="car-btn" data-dir="1" aria-label="Siguiente">
                        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                    </button>
                </div>
            </div>
            <p class="max-w-xl">
                Así quedaría la web de un negocio como el tuyo. Son demos de rediseño que hicimos para agencias de turismo en Cusco, no sitios publicados por ellos.
            </p>

            <div id="carousel" class="carousel -mx-4 px-4 md:mx-0 md:px-0" tabindex="0" aria-label="Demos de rediseño">
                {demos.map((d) => (
                    <figure class="carousel-item">
                        <div class="aspect-[16/10] bg-neutral-900 overflow-hidden border border-neutral-900">
                            <img src={d.img} alt={`Demo de rediseño de ${d.name}`} loading="lazy" class="w-full h-full object-cover object-top" />
                        </div>
                        <figcaption class="pt-4 space-y-1">
                            <p class="font-semibold text-neutral-100!">{d.name}</p>
                            <p class="text-sm">{d.text}</p>
                        </figcaption>
                    </figure>
                ))}
            </div>

            <div class="pt-8 space-y-2">
                <h3 class="text-xl font-semibold text-neutral-100">Software propio que ya construimos</h3>
                <p class="max-w-xl">Productos reales de ingeniería, con mapas, machine learning e IA sin conexión.</p>
            </div>
            <ol>
                {projects.map(({ slug, name }) => ({
                    slug,
                    name,
                    tagline: {
                        wayperu: "App móvil que traza la ruta más segura por todo el Perú.",
                        centinela: "Machine learning que detecta la mosca de la fruta y avisa al agricultor.",
                        nova: "Asistente educativo sin conexión para estudiantes rurales.",
                    }[slug],
                })).map(({ slug, name, tagline }) => (
                    <li>
                        <a
                            href={`/work/${slug}`}
                            class="flex items-center justify-between gap-6 py-5 border-t border-neutral-900 hover:text-blue-500 transition-all duration-150"
                        >
                            <span class="flex flex-col gap-1">
                                <span class="text-base font-semibold text-neutral-100">{name}</span>
                                <span class="text-sm text-neutral-500 max-w-md">{tagline}</span>
                            </span>
                            <svg class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                        </a>
                    </li>
                ))}
            </ol>
        </section>

        <Footer />
    </main>
</Layout>

<script is:inline define:vars={{ PHONE }}>
    const car = document.getElementById("carousel");
    document.querySelectorAll(".car-btn").forEach((b) =>
        b.addEventListener("click", () => {
            const item = car.querySelector(".carousel-item");
            car.scrollBy({ left: Number(b.dataset.dir) * (item.offsetWidth + 24), behavior: "smooth" });
        })
    );
</script>

<style is:global>
    .section-title {
        font-size: 1.5rem;
        font-weight: 600;
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
    }
    .cta-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6em;
        padding: 0.8em 1.3em;
        background: #3b82f6;
        color: #fff;
        font-weight: 600;
        font-size: 0.95rem;
        border: 1px solid #3b82f6;
        border-radius: 2px;
        cursor: pointer;
        transition: background 150ms, border-color 150ms;
    }
    .cta-primary:hover {
        background: #60a5fa;
        border-color: #60a5fa;
        color: #0a0a0a;
    }
    .cta-link {
        display: inline-flex;
        align-items: center;
        gap: 0.6em;
        color: #f0efee;
        font-weight: 500;
        white-space: nowrap;
        transition: color 150ms;
    }
    .cta-link:hover { color: #3b82f6; }
    .cta-link:hover svg { transform: translateX(4px); }

    .carousel {
        display: flex;
        gap: 1.5rem;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
    }
    .carousel::-webkit-scrollbar { display: none; }
    .carousel-item {
        flex: 0 0 88%;
        scroll-snap-align: start;
    }
    @media (min-width: 768px) {
        .carousel-item { flex-basis: 78%; }
    }
    .car-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border: 1px solid #404040;
        transition: background 150ms, color 150ms;
    }
    .car-btn:hover { background: #fff; color: #0a0a0a; }

</style>
