---
import Layout from "../layouts/Layout.astro";
import AgencyHeader from "../components/agency/AgencyHeader.astro";
import Hero from "../components/agency/Hero.astro";
import Problem from "../components/agency/Problem.astro";
import Method from "../components/agency/Method.astro";
import WebServices from "../components/agency/WebServices.astro";
import Seo from "../components/agency/Seo.astro";
import Cases from "../components/agency/Cases.astro";
import Team from "../components/agency/Team.astro";
import Faq from "../components/agency/Faq.astro";
import Closing from "../components/agency/Closing.astro";
import AgencyFooter from "../components/agency/AgencyFooter.astro";
import StickyBar from "../components/agency/StickyBar.astro";
import Reveal from "../components/agency/Reveal.astro";
import "../styles/agency.css";
---

<Layout
    bare
    lang="es"
    title="SaskDev | Páginas web, software e IA para negocios en Perú"
    description="Agencia de desarrollo web y software en Perú. Páginas web, tiendas online, apps a medida e IA. Cotización gratis en menos de 24 horas."
>
    <script is:inline slot="head">document.documentElement.classList.add("js");</script>
    <div class="ag">
        <AgencyHeader />
        <main id="inicio">
            <Hero />
            <Problem />
            <Method />
            <WebServices />
            <Seo />
            <Cases />
            <Team />
            <Faq />
            <Closing />
        </main>
        <AgencyFooter />
        <StickyBar />
    </div>
    <Reveal />
</Layout>
