---
import { method } from "../../data/agency.js";
---

<section class="sec dark" data-theme="dark" id="metodo" aria-labelledby="h-met">
    <div class="wrap split">
        <div>
            <span class="eyebrow rv">// Método</span>
            <h2 id="h-met" class="rv" style="--i:1">Entendemos tu negocio antes de diseñar una sola pantalla.</h2>
            <p class="lead rv after" style="--i:2">
                Estudiamos a tus competidores en Perú, ordenamos el mensaje y recién después diseñamos. Cada decisión
                tiene una razón que te explicamos por escrito.
            </p>
        </div>
        <ol class="steps">
            {method.map(([title, text], i) => (
                <li class="rv" style={`--i:${i}`}>
                    <span class="n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                    <div><div class="h3">{title}</div><p>{text}</p></div>
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    .steps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
    .steps li {
        display: grid;
        grid-template-columns: 4.5rem 1fr;
        gap: 1rem;
        padding: 1.75rem 0;
        border-bottom: 1px solid var(--line);
    }
    .n {
        font-weight: 600;
        letter-spacing: -0.04em;
        font-size: clamp(2rem, 4vw, 3.25rem);
        line-height: 1;
        font-variant-numeric: lining-nums;
    }
    .steps .h3 { margin-bottom: 0.4rem; }
    @media (min-width: 900px) { .steps li { grid-template-columns: 7rem 1fr; } }
</style>
