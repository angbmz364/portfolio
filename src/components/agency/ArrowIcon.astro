---
const { class: className = "", direction = "right", width = 1.25 } = Astro.props;
const d = direction === "left" ? "M20 12H4M10 6l-6 6 6 6" : "M4 12h16M14 6l6 6-6 6";
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={width} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d={d} />
</svg>
