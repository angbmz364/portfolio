---
import { steps } from "../../data/agency.js";
---

<section class="sec dark" data-theme="dark" id="proceso" aria-labelledby="h-proc">
    <div class="wrap">
        <h2 id="h-proc" class="rv">Hablas directo con quien programa tu proyecto.</h2>
        <div class="who">
            <div class="founder rv">
                <img src="/saskdev.webp" alt="Angel Bernal, fundador de SaskDev" width="1440" height="1440" loading="lazy" />
                <div class="cap">Angel Bernal, fundador</div>
                <p class="txt">
                    SaskDev lo dirige Angel Bernal, ingeniero de software peruano con más de 2 años construyendo web, apps móviles y modelos de machine learning.
                    Sin intermediarios ni gerentes de cuenta: lo que acuerdas es lo que se construye.
                </p>
            </div>
            <ol class="steps">
                {steps.map(([title, text], i) => (
                    <li class="rv" style={`--i:${i}`}>
                        <span class="n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                        <div><div class="h3">{title}</div><p>{text}</p></div>
                    </li>
                ))}
            </ol>
        </div>
    </div>
</section>

<style>
    h2 { max-width: 13em; }
    .who { display: grid; gap: 3rem; margin-top: clamp(2.5rem, 5vw, 4rem); }
    @media (min-width: 900px) { .who { grid-template-columns: 5fr 7fr; } }
    .founder img { width: 100%; height: auto; max-width: 420px; aspect-ratio: 1; object-fit: cover; filter: grayscale(1) contrast(1.05); }
    .cap { margin-top: 0.9rem; font-weight: 600; color: var(--fg); }
    .txt { margin-top: 1.25rem; max-width: 34rem; }
    .steps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
    .steps li { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1rem; padding: 1.75rem 0; border-bottom: 1px solid var(--line); }
    .n { font-weight: 600; letter-spacing: -0.04em; font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1; color: var(--fg); font-variant-numeric: lining-nums; }
    .steps .h3 { margin-bottom: 0.4rem; }
    @media (min-width: 900px) { .steps li { grid-template-columns: 7rem 1fr; } }
</style>
