---
import { EMAIL, PHONE, PHONE_LABEL, X_URL, INSTAGRAM_URL } from "../../data/agency.js";
---

<footer class="dark" data-theme="dark">
    <div class="wrap">
        <div class="brand"><img src="/logo-white.svg" alt="SaskDev" width="96" height="96" loading="lazy" /><span>SaskDev</span></div>
        <div>
            <div class="links">
                <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
                <a href={`tel:+${PHONE}`}>{PHONE_LABEL}</a>
                <a href={X_URL} target="_blank" rel="noopener">X</a>
                <a href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram</a>
            </div>
            <p class="copy">© {new Date().getFullYear()} SaskDev</p>
        </div>
    </div>
</footer>

<style>
    footer { border-top: 1px solid var(--line); padding: clamp(3rem, 6vw, 5rem) 0 clamp(6rem, 8vw, 3.5rem); }
    .wrap { display: grid; gap: 2.5rem; }
    .brand { display: flex; align-items: center; gap: 1.5rem; }
    .brand img { width: 96px; height: 96px; }
    .brand span { font: 600 2rem/1 var(--sans); letter-spacing: -0.03em; }
    .links { display: flex; flex-wrap: wrap; gap: 0.25rem 2rem; }
    .links a { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; min-width: 48px; color: var(--ink2); text-underline-offset: 0.25em; }
    .copy { color: var(--ink2); font-size: 0.875rem; margin: 0; }
    @media (min-width: 900px) {
        footer { padding-bottom: 3.5rem; }
        .wrap { grid-template-columns: 5fr 7fr; align-items: center; }
    }
</style>
