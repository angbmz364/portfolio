---
import { EMAIL, PHONE, PHONE_LABEL, X_URL, INSTAGRAM_URL, wa } from "../../data/agency.js";

const { home = true } = Astro.props;
const root = home ? "" : "/agency";
---

<footer class="dark" data-theme="dark">
    <div class="wrap foot">
        <div class="brand"><img src="/logo-white.svg" alt="SaskDev" width="96" height="96" loading="lazy" /></div>
        <nav class="col" aria-label="Servicios">
            <h3>Servicios</h3>
            <a href={`${root}#diseno-web`}>Diseño web</a>
            <a href={`${root}#seo`}>SEO</a>
            <a href={`${root}#casos`}>Casos de éxito</a>
        </nav>
        <div class="col">
            <h3>Contacto</h3>
            <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
            <a href={`tel:+${PHONE}`}>{PHONE_LABEL}</a>
            <a href={`https://wa.me/${PHONE}`} target="_blank" rel="noopener">WhatsApp</a>
        </div>
        <div class="col">
            <h3>Redes</h3>
            <a href={X_URL} target="_blank" rel="noopener">X</a>
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram</a>
        </div>
    </div>
    <div class="wrap"><p class="copy">© {new Date().getFullYear()} SaskDev</p></div>
</footer>

<style>
    footer { border-top: 1px solid var(--line); padding: clamp(3rem, 6vw, 5rem) 0 clamp(6rem, 8vw, 3.5rem); }
    .foot { display: grid; gap: 2.5rem; }
    .brand { display: flex; align-items: center; gap: 1.5rem; }
    .brand img { width: 96px; height: 96px; }
    .brand span { font: 600 2rem/1 var(--sans); letter-spacing: -0.03em; }
    .col { display: flex; flex-direction: column; }
    .col h3 { font: 500 0.9375rem/1.4 var(--sans); color: var(--ink2); margin: 0 0 0.5rem; }
    .col a { display: inline-flex; align-items: center; min-height: 48px; color: var(--fg); text-underline-offset: 0.25em; text-decoration: none; }
    @media (hover: hover) { .col a:hover { text-decoration: underline; } }
    .copy { margin-top: 3rem; color: var(--ink2); font-size: 0.875rem; }
    @media (min-width: 900px) {
        footer { padding-bottom: 3.5rem; }
        .foot { grid-template-columns: 1.4fr 1fr 1fr 1fr; align-items: start; gap: 3rem; }
    }
</style>
