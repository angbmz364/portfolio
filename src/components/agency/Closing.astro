---
import WhatsAppButton from "./WhatsAppButton.astro";
import { EMAIL, PHONE, PHONE_LABEL } from "../../data/agency.js";
---

<section class="close dark" data-theme="dark" id="cierre" aria-labelledby="h-close">
    <div class="wrap">
        <h2 id="h-close" class="rv">Escríbenos hoy y recibe tu cotización mañana.</h2>
        <WhatsAppButton size="lg" class="rv" />
        <div class="contact">
            <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
            <a href={`tel:+${PHONE}`}>{PHONE_LABEL}</a>
        </div>
    </div>
</section>

<style>
    .close { padding-top: var(--sec); padding-bottom: var(--sec); }
    h2 { font-size: clamp(2.25rem, 6vw, 5rem); line-height: 1; max-width: 14em; }
    .close :global(.btn) { margin-top: clamp(2rem, 4vw, 3rem); }
    .contact { margin-top: 1.75rem; display: flex; flex-wrap: wrap; gap: 0.25rem 2rem; }
    .contact a { display: inline-flex; align-items: center; min-height: 48px; color: var(--ink2); text-underline-offset: 0.25em; }
</style>
