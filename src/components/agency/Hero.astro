---
import WhatsAppButton from "./WhatsAppButton.astro";
import { commitments } from "../../data/agency.js";
---

<section class="hero dark" data-theme="dark" aria-labelledby="h-hero">
    <div class="wrap main">
        <h1 id="h-hero" class="rv">Tu negocio, vendiendo en internet las 24 horas.</h1>
        <p class="lead rv" style="--i:1">
            Creamos tu página web, tienda online, software o automatización con IA. Tú nos cuentas qué necesitas.
            Nosotros lo construimos y lo ponemos en línea.
        </p>
        <div class="cta-row rv" style="--i:2">
            <WhatsAppButton id="hero-cta" size="lg" />
            <span class="small">Respuesta en menos de 24 horas. Sin compromiso.</span>
        </div>
    </div>
    <div class="wrap full">
        <div class="commit">
            {commitments.map(([title, text]) => (
                <div><strong>{title}</strong><span>{text}</span></div>
            ))}
        </div>
    </div>
</section>

<style>
    .hero {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        padding-top: calc(var(--headh) + clamp(1.5rem, 4vh, 3rem));
    }
    .main {
        width: 100%;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: clamp(1.25rem, 3vh, 2rem);
        padding-bottom: clamp(1.5rem, 4vh, 3rem);
    }
    .full { width: 100%; }
    h1 { max-width: 10.5em; }
    .cta-row { display: flex; flex-direction: column; align-items: flex-start; gap: 0.9rem; }
    .cta-row .small { color: var(--ink2); }
    .lead { color: var(--ink2); margin: 0; }
    .commit { display: grid; grid-template-columns: 1fr; border-top: 1px solid var(--line); }
    .commit div { padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
    .commit div:last-child { border-bottom: 0; }
    .commit strong { display: block; font-weight: 600; font-size: 1.0625rem; }
    .commit span { color: var(--ink2); font-size: 0.9375rem; }
    @media (min-width: 900px) {
        .commit { grid-template-columns: repeat(3, 1fr); }
        .commit div { padding: 1.4rem 2rem 1.6rem 0; border-bottom: 0; }
        .commit div + div { padding-left: 2rem; border-left: 1px solid var(--line); }
    }
    @media (min-width: 900px) and (max-height: 820px) {
        h1 { font-size: clamp(2.6rem, min(7vw, 11vh), 6.25rem); }
        .lead { font-size: 1.125rem; }
    }
</style>
