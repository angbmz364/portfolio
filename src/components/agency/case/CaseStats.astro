---
const { items, note } = Astro.props;
---

<section class="sec dark" data-theme="dark" aria-label="Indicadores" style="padding-top:0">
    <div class="wrap">
        <div class="stats">
            {items.map(([value, label], i) => (
                <div class="stat rv" style={`--i:${i}`}><b>{value}</b><span>{label}</span></div>
            ))}
        </div>
        <p class="note rv">{note}</p>
    </div>
</section>

<style>
    .stats { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }
    .stat { padding: 2rem 1rem 2rem 0; border-bottom: 1px solid var(--line); }
    .stat b {
        display: block;
        font-weight: 600;
        font-size: clamp(2.4rem, 4.6vw, 4.5rem);
        line-height: 1;
        letter-spacing: -0.04em;
        white-space: nowrap;
    }
    .stat span { display: block; margin-top: 0.75rem; color: var(--ink2); font-size: 0.9375rem; max-width: 14rem; }
    .note { margin-top: 1.5rem; font-size: 0.9375rem; }
    @media (min-width: 900px) {
        .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        .stat { padding: 2.5rem 2rem 2.5rem 0; border-bottom: 0; }
        .stat + .stat { padding-left: 2rem; border-left: 1px solid var(--line); }
    }
</style>
