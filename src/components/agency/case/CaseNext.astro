---
import ArrowIcon from "../ArrowIcon.astro";
import { nextLabel } from "../../../data/cases.js";

const { next } = Astro.props;
---

<section class="sec light" data-theme="light" aria-label="Siguiente caso">
    <div class="wrap">
        <a class="next rv" href={`/agency/casos/${next}`}>
            <span><small>Siguiente caso</small><span class="h3">{nextLabel[next]}</span></span>
            <ArrowIcon class="arrow" />
        </a>
    </div>
</section>

<style>
    .next {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        min-height: 96px;
        padding: 1.75rem 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        text-decoration: none;
        color: var(--fg);
    }
    small { display: block; font-size: 0.9375rem; color: var(--ink2); }
    .next :global(.arrow) { width: 36px; height: 36px; }
    @media (hover: hover) { .next:hover :global(.arrow) { transform: translateX(6px); } }
    @media (prefers-reduced-motion: reduce) { .next :global(.arrow) { transition: none; } }
</style>
