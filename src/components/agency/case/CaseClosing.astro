---
import WhatsAppButton from "../WhatsAppButton.astro";

const { title, msg } = Astro.props;
---

<section class="close dark" data-theme="dark" id="cierre" aria-labelledby="h-close">
    <div class="wrap">
        <span class="eyebrow rv">Antes de irte</span>
        <h2 id="h-close" class="rv" style="--i:1">{title}</h2>
        <div class="pair rv">
            <WhatsAppButton size="lg" {msg} label="Cuéntanos tu idea" />
            <a class="more" href="/agency#casos">Ver más casos</a>
        </div>
    </div>
</section>

<style>
    .close { padding-top: var(--sec); padding-bottom: var(--sec); }
    h2 { font-size: clamp(2.6rem, 7vw, 6.5rem); line-height: 1; max-width: 13em; }
    .pair { display: flex; flex-wrap: wrap; align-items: center; margin-top: clamp(2rem, 4vw, 3rem); }
    .more { display: inline-flex; align-items: center; min-height: 56px; margin-left: 1.5rem; color: var(--ink2); text-underline-offset: 0.25em; }
</style>
