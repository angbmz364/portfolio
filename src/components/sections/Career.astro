---
const experience = [
    {
        title: "Infrastructure Engineer",
        company: "DiofStudios",
        date: "Oct 2026 — Present",
        url: "https://diofstudios.com",
    },
    {
        title: "Full-Stack Engineer",
        company: "DiofStudios",
        date: "March 2026 — Sep 2026",
        url: "https://diofstudios.com",
    },
    {
        title: "Freelancer Web Developer",
        company: "Freelancer",
        date: "Dec 2025 - Present"
    },
];
---

<section id="career" class="py-24 space-y-8 border-t border-neutral-900">
    <h2 class="text-2xl font-semibold flex items-baseline gap-3">
        <span class="text-sm text-neutral-600">02</span>Career
    </h2>

    <ol>
        {
            experience.map(({ title, company, date, url }) => (
                <li>
                    <a
                        href={ url ? url : '#' }
                        target={ url ? "_blank" : "_self" }
                        class="flex flex-col items-start gap-1 py-5 border-t border-neutral-900 hover:text-blue-500 transition-all duration-150 md:flex-row md:items-baseline md:justify-between md:gap-6"
                    >
                        <span class="flex flex-col gap-1">
                            <span class="text-base font-semibold text-neutral-100">{title}</span>
                            <span class="text-sm text-neutral-500">{company}</span>
                        </span>
                        <span class="text-sm text-neutral-600 md:whitespace-nowrap">{date}</span>
                    </a>
                </li>
            ))
        }
    </ol>
</section>
