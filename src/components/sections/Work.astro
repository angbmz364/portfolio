---
import { projects } from "../../data/projects.js";
---

<section id="work" class="py-24 space-y-8 border-t border-neutral-900">
    <h2 class="text-2xl font-semibold flex items-baseline gap-3">
        <span class="text-sm text-neutral-600">03</span>Work
    </h2>

    <ol>
        {
            projects.map(({ slug, name, tagline }) => (
                <li>
                    <a
                        href={`/work/${slug}`}
                        class="flex items-center justify-between gap-6 py-5 border-t border-neutral-900 hover:text-blue-500 transition-all duration-150"
                    >
                        <span class="flex flex-col gap-1">
                            <span class="text-base font-semibold text-neutral-100">{name}</span>
                            <span class="text-sm text-neutral-500 max-w-md">{tagline}</span>
                        </span>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.8"
                            stroke="currentColor"
                            class="size-4 shrink-0"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                        </svg>
                    </a>
                </li>
            ))
        }
    </ol>
</section>
