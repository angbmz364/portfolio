---
import "@fontsource-variable/onest/wght.css";
import '../styles/global.css';

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="author" content="SaskDev" />
    <meta name="keywords" content="saskdev, software engineer, Angel Bernal, portfolio" />
    <meta name="description" content=`${description}` />
    <link
      rel="favicon icon"
      href="/logo-white.svg"
      type="image/svg"
    />
    <title>{title}</title>
  </head>
  <body class="bg-neutral-950">
    <div class="page"><slot /></div>
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  body {
    color: #f0efee;
    font-family: 'Onest Variable', sans-serif;
    overflow-x: hidden;
  }
  .page {
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 4rem);
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 768px) {
    .page {
      flex-direction: row;
    }
  }
</style>
