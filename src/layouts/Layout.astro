---
import "@fontsource-variable/onest/wght.css";

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="author" content="SaskDev" />
    <meta name="keywords" content="saskdev, software engineer, Angel Bernal, portfolio" />
    <meta name="description" content=`${description}` />
    <link
      rel="favicon icon"
      href="/logo-white.svg"
      type="image/svg"
    />
    <title>{title}</title>
  </head>
  <body class="bg-neutral-950">
    <slot />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  body {
    color: #fff;
    display: flex;
    overflow-x: hidden;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: "Onest Variable", sans-serif;
  }
</style>
