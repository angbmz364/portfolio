---
import "@fontsource-variable/onest/wght.css";
import '../styles/global.css';

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="author" content="SaskDev" />
    <meta name="keywords" content="saskdev, software engineer, Angel Bernal, portfolio" />
    <meta name="description" content=`${description}` />
    <link
      rel="favicon icon"
      href="/logo-white.svg"
      type="image/svg"
    />
    <title>{title}</title>
  </head>
  <body class="bg-neutral-950">
    <main><slot /></main>
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  body {
    color: #f0efee;
    display: grid;
    place-content: center;
    max-width: 1200px;
    overflow-x: hidden;
    font-family: 'Onest Variable', sans-serif;
  }
</style>
